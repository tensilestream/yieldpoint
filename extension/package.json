{
  "name": "yieldpoint",
  "displayName": "Yieldpoint",
  "description": "Deterministically detect when a change weakens what the tests verify. No model call.",
  "version": "0.1.3",
  "publisher": "tensilestream",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "https://github.com/tensilestream/yieldpoint" },
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Linters", "Testing"],
  "activationEvents": ["workspaceContains:**/.yieldpoint.json"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "yieldpoint.review", "title": "Yieldpoint: Review uncommitted changes" },
      { "command": "yieldpoint.scan", "title": "Yieldpoint: Scan the whole workspace" }
    ],
    "configuration": {
      "title": "Yieldpoint",
      "properties": {
        "yieldpoint.executable": {
          "type": "string",
          "default": "yieldpoint",
          "description": "Path to the yieldpoint executable."
        },
        "yieldpoint.runOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Re-review uncommitted changes when a file is saved."
        }
      }
    }
  },
  "scripts": { "compile": "tsc -p ./", "watch": "tsc -watch -p ./" },
  "devDependencies": { "@types/node": "^20", "@types/vscode": "^1.85.0", "typescript": "^5.4.0" }
}
