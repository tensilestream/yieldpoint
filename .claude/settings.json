{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "yieldpoint hook"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "yieldpoint hook --stop"
          },
          {
            "type": "command",
            "command": "yieldpoint report"
          }
        ]
      }
    ]
  }
}
