{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "command -v yieldpoint >/dev/null 2>&1 && yieldpoint hook || exit 0"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "command -v yieldpoint >/dev/null 2>&1 && yieldpoint hook --stop || exit 0"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "command -v yieldpoint >/dev/null 2>&1 && yieldpoint hook --post || exit 0"
          }
        ]
      }
    ]
  }
}
